# Rust/Cargo
src-tauri/target/
src-tauri/gen/
.cargo/

# Python
__pycache__/

# Node
node_modules/
dist/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Google OAuth client credentials downloaded from Cloud Console for local dev
# (see src-tauri/src/auth.rs's client_secret_file) — never commit these.
client_secret_*.json
src-tauri/client_secret_*.json

# Tauri build artefacts
*.msi
*.deb
*.AppImage
*.dmg

# Built offline-site bundle (regenerated by scripts/build-offline-site.sh /
# `cargo tauri build`'s beforeBuildCommand from the GoopieWebsite submodule).
# Only the placeholder index.html ships in git, so a plain `cargo build`
# always has *something* to embed without needing a Node/bun toolchain.
/src-tauri/offline-site/*
!/src-tauri/offline-site/index.html
