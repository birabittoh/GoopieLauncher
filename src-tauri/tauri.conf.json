{
  "$schema": "./gen/schemas/desktop-schema.json",
  "productName": "Goopie Launcher",
  "version": "1.5.1",
  "identifier": "xyz.goopie.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "https://goopie.xyz",
    "beforeDevCommand": "",
    "beforeBuildCommand": "bash ./scripts/build-offline-site.sh"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {}
  }
}
